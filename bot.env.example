# Copy this file to .env and fill in your values.
# Windows CMD:  copy bot.env.example .env
# PowerShell:   Copy-Item bot.env.example .env

# --- Base44 Trade Sentinel dashboard ---
BASE44_API_KEY=your_base44_api_token_here
BASE44_APP_ID=6a5889155e63aca9fe8175e5
BASE44_APP_BASE_URL=https://nondescript-trade-sentinel-pro.base44.app
BASE44_SETTINGS_ID=6a5889a0b628948d90d3f8bd

# --- Discord alerts (create webhook in Discord channel settings) ---
# NO quotes around the URL. Example:
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/AbCdEfGhIjKlMnOpQrStUvWxYz
DISCORD_WEBHOOK_URL=

# --- Telegram alerts (create bot via @BotFather, get chat id via @userinfobot) ---
# Open your bot in Telegram and press START before testing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Bot behaviour ---
BOT_MODE=auto
SYMBOLS_TO_TRADE=EURUSD,GBPUSD,USDJPY,AUDUSD
BOT_POLL_SECONDS=10
BOT_TEST_CYCLES=0
MAX_OPEN_TRADES_PER_SYMBOL=1
MAX_SPREAD_POINTS=25
RISK_PERCENT=1.0
DEFAULT_SL_PIPS=15
DEFAULT_TP_PIPS=30
MAGIC_NUMBER=20260716
